{
  "name": "finscript-studio",
  "version": "0.1.3",
  "description": "NIHILPOINTZERO-OS — institutional-grade financial content & analysis engine (Roman Urdu / Urdu / English)",
  "main": "./out/main/index.js",
  "private": true,
  "overrides": {
    "sharp": "0.35.4",
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "probe": "vite --config vite.probe.config.ts",
    "build": "electron-vite build && node scripts/build-remote-bridge.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "lint": "eslint src",
    "changelog:update": "node scripts/update-changelog.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "ship": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ship.ps1",
    "typecheck:phone": "tsc -p tsconfig.phone.json --noEmit && tsc -p tsconfig.phone-test.json --noEmit",
    "build:phone": "node scripts/build-phone.mjs",
    "publish:phone": "node scripts/build-phone.mjs && node scripts/publish-phone.mjs",
    "build:bridge": "node scripts/build-remote-bridge.mjs",
    "typecheck:remote": "tsc -p tsconfig.remote.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@huggingface/transformers": "^4.2.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "history": "^5.3.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}