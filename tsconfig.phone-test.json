{
  // The phone app's TESTS. Separate from tsconfig.phone.json because tests may use
  // node APIs (reading the built bundle off disk) while the shipped app may not.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["phone/src/**/*.test.ts"]
}
